# MongoDB connection string.
#
# Option A (zero-setup local dev): run `npm run dev:db` in a separate terminal.
# It starts a real mongod binary as a single-node replica set (via mongodb-memory-server)
# on a fixed port and prints the URI to use here.
#   MONGODB_URI=mongodb://127.0.0.1:27117/todoapp?replicaSet=testset
#
# Option B (MongoDB Atlas free tier, always a replica set, works for prod too):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todoapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27117/todoapp?replicaSet=testset

# GitHub OAuth login.
#
# 1. Go to https://github.com/settings/developers -> "New OAuth App".
# 2. Homepage URL: http://localhost:3000
#    Authorization callback URL: http://localhost:3000/auth/github/callback
# 3. Copy the generated Client ID, and generate + copy a Client Secret.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Secret used to sign the session cookie (HMAC via `jose`). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace_with_a_random_32_byte_base64_string
