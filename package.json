{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "MONGODB_URI=mongodb://127.0.0.1:27117/todoapp_e2e?replicaSet=testset node --env-file=.env --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "seed": "tsx --env-file=.env --env-file=.env.local scripts/seed.ts",
    "migrate:add-user-id": "tsx --env-file=.env --env-file=.env.local scripts/migrate-add-user-id.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "jose": "^6.2.12",
    "mongoose": "^9.10.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
